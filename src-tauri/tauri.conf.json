{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FastFiles",
  "version": "1.7.0",
  "identifier": "io.twinup.fastfiles",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "FastFiles",
        "width": 1040,
        "height": 700,
        "minWidth": 760,
        "minHeight": 540,
        "center": true,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://i.ytimg.com; frame-src https://www.youtube.com; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Twinup",
    "shortDescription": "Ofis içi hızlı dosya transferi",
    "longDescription": "FastFiles, aynı ağdaki bilgisayarlar arasında internete çıkmadan, şifreli ve hızlı dosya/klasör gönderip almanızı sağlar.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Turkish", "English"]
      }
    }
  }
}
